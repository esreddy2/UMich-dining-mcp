# Safe public defaults; do not commit credentials.
UMICH_MCP_HTTP_HOST=127.0.0.1
UMICH_MCP_HTTP_PORT=8080
UMICH_MCP_ALLOWED_HOSTS=umich-dining-mcp.duckdns.org
UMICH_MCP_ALLOWED_ORIGINS=umich-dining-mcp.duckdns.org
UMICH_MCP_TRUST_PROXY=1
# The proxy allows 60/min; this budget sits above it, so the proxy is the limit a
# client meets and the application is the last line rather than the first.
UMICH_MCP_RATE_PER_MINUTE=120
UMICH_MCP_MAX_CONCURRENT_PER_IP=4
UMICH_MCP_MAX_CONCURRENT_TOTAL=16
# Leave unset for a public, read-only registry endpoint.
# UMICH_MCP_BEARER_TOKEN_SHA256=<SHA256_OF_LONG_RANDOM_TOKEN>
# Use original upstream limiter, cache and tiny concurrency: do not raise.
UMICH_DINING_MAX_CONCURRENCY=2
UMICH_DINING_MIN_GAP_MS=500
# The persistent cache. The unit declares StateDirectory=umich-dining-mcp,
# which systemd creates and hands to the service account, so this path is
# writable even though ProtectSystem=strict is on.
UMICH_DINING_CACHE_DIR=/var/lib/umich-dining-mcp/cache
UMICH_DINING_CACHE_MAX_AGE_DAYS=30
UMICH_DINING_CACHE_MAX_SIZE_MB=200
UMICH_DINING_CACHE_PRUNE_INTERVAL_MS=3600000
